{
  "name": "jcdp",
  "version": "@JCDP_VERSION@",
  "description": "WASM bindings for Jacobian Chain Dynamic Programming (JCDP)",
  "type": "module"
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  }
  "files": [
    "dist",
    "lib"
  ],
  "repository": {
    "type": "git",
    "url": "git://github.com/STCE-at-RWTH/Jacobian-Chaining.git"
  },
  "scripts": {
    "build": "tsc",
    "test": "node test/test.js",
    "prepublishOnly": "npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "jacobian",
    "chaining",
    "wasm",
    "optimization"
  ],
  "author": {
    "name": "Simon Maertens",
    "email": "git@slmaertens.dev",
    "url": "https://github.com/ACSimon33"
  },
  "license": "CC-BY-4.0",
  "devDependencies": {
    "typescript": "^5.0.0",
    "@types/node": "^20.0.0",
    "prettier": "^3.6.2"
  }
}
